# Die Einstellungen und Hilfsdateien dürfen nicht direkt aufgerufen werden.
<FilesMatch "^(config\.php|config\.example\.php|lib\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
Options -Indexes
