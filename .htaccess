# EMONA leicht – Server-Einstellungen für Apache

# Alle App-Dateien nie lange zwischenspeichern, damit Updates sofort ankommen (seit 25.10.2026 auch .js und .css).
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|json|html|webmanifest)$">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_expires.c>
  <FilesMatch "\.(js|css|json|html|webmanifest)$">
    ExpiresActive Off
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
  AddCharset utf-8 .js .css .json .html .webmanifest
</IfModule>

Options -Indexes
