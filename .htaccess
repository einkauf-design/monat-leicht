# EMONA leicht – Server-Einstellungen für Apache

# Service Worker, Manifest und Inhalte nie lange zwischenspeichern, damit Updates sofort ankommen.
<IfModule mod_headers.c>
  <FilesMatch "^(sw\.js|manifest\.webmanifest|index\.html|inhalte\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType text/javascript .js
  AddCharset utf-8 .js .css .json .html .webmanifest
</IfModule>

Options -Indexes
